<div class="points-grid">
  <% data.grading.components.each do |component| %>
    <div class="card">
      <h3 class="card-title"><%= component.name %></h3>
      <p class="points-total"><%= component.total %> <small>points</small></p>
      <ul class="points-list">
        <% component.parts.each do |part| %>
          <li><span><%= part.label %></span><span><%= part.points %></span></li>
        <% end %>
      </ul>
    </div>
  <% end %>
</div>

<div class="callout">
  <p><%= data.grading.pass_rule %></p>
</div>

<div class="table-wrap">
  <table class="scale-table">
    <caption>Grading scale</caption>
    <thead>
      <tr><th scope="col">Grade</th><th scope="col">Percentage</th></tr>
    </thead>
    <tbody>
      <% data.grading.scale.each do |row| %>
        <tr><th scope="row"><%= row.grade %></th><td><%= row.range %></td></tr>
      <% end %>
    </tbody>
  </table>
</div>
