#!/usr/bin/env ruby
# Turns the built site into HTML that can be pasted into Carmen (Canvas) pages.
#
# Canvas removes <style>, <script>, and <link> tags, so every rule in carmen-src/carmen.css
# is inlined into style="" attributes. Links between pages are rewritten to their Carmen URLs.
#
# Usage: bundle exec middleman build && bundle exec ruby bin/carmen

Encoding.default_external = Encoding::UTF_8

require "bundler/setup"
require "yaml"
require "premailer"
require "nokogiri"

ROOT = File.expand_path("..", __dir__)
course = YAML.load_file(File.join(ROOT, "data/course.yml"))
pages = YAML.load_file(File.join(ROOT, "data/carmen.yml")).fetch("pages")
css = File.read(File.join(ROOT, "carmen-src/carmen.css"))
out_dir = File.join(ROOT, "carmen")
base = course.fetch("carmen_url")

def carmen_href(href, pages, base)
  return href if href.nil? || href.start_with?("http", "mailto:")
  return href if href.start_with?("#")

  file, anchor = href.sub(%r{\A(\./)+}, "").split("#", 2)
  page = pages[file]
  return href unless page

  "#{base}#{page.fetch('path')}#{anchor ? "##{anchor}" : ''}"
end

Dir.mkdir(out_dir) unless Dir.exist?(out_dir)
index = []

pages.each do |file, page|
  source = File.join(ROOT, "site", file)
  abort "Missing #{source}. Run `bundle exec middleman build` first." unless File.exist?(source)

  doc = Nokogiri::HTML(File.read(source))
  content = doc.at_css("main .container")

  # Canvas drops inline SVG, so the icons go. Everything else keeps its markup.
  content.css("svg").each(&:remove)
  content.css("a[href]").each { |a| a["href"] = carmen_href(a["href"], pages, base) }

  html = <<~HTML
    <!doctype html>
    <html><head><meta charset="utf-8"><style>#{css}</style></head>
    <body><div class="carmen-root">#{content.inner_html}</div></body></html>
  HTML

  premailer = Premailer.new(html, with_html_string: true, adapter: :nokogiri,
                                  remove_classes: true, remove_ids: false,
                                  remove_comments: true, preserve_styles: false,
                                  include_link_tags: false, warn_level: Premailer::Warnings::NONE)
  inlined = Nokogiri::HTML(premailer.to_inline_css).at_css("body").inner_html.strip
  # Collapse the blank lines left behind by ERb so the paste is tidy.
  inlined = inlined.gsub(/\n\s*\n+/, "\n")

  name = File.basename(file, ".html")
  File.write(File.join(out_dir, "#{name}.html"), inlined + "\n")
  index << "| `carmen/#{name}.html` | #{page.fetch('paste_into')} | #{base}#{page.fetch('path')} |"
  puts "  carmen/#{name}.html"
end

File.write(File.join(out_dir, "README.md"), <<~MD)
  # Carmen pages

  Generated by `bin/carmen`. Do not edit these files by hand: change `data/` or `source/`, rebuild, and rerun.

  To publish a page, open it in Carmen, switch the editor to the HTML view, replace everything with the file's contents, and save.

  | File | Paste into | URL |
  |---|---|---|
  #{index.join("\n")}

  The "Upcoming" list and "This week" markers are fixed at build time, so rebuild when the schedule changes.
MD
puts "Done."
